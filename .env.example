# .env.example — Variabel Lingkungan Produksi Biznet Gio cPanel (TANPA NILAI RAHASIA, SEC-003)
# Salin ke .env.local untuk pengembangan lokal; masukkan nilai produksi di menu Setup Node.js App cPanel.

# 1. Domain & Identitas Situs (Contoh: SITE_URL=https://fsdanrekan.com, PORT=3000)
PORT=
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# 2. Database MySQL / MariaDB cPanel (Contoh: mysql://user:pass@localhost:3306/prefix_dbname)
DATABASE_URL=

# 3. Keamanan Sesi & Enkripsi (Gunakan string acak minimal 32 karakter)
SESSION_SECRET=
PAYLOAD_SECRET=

# 4. Akun Admin Pertama (Dibaca oleh skrip migrasi, wajib diganti saat login pertama)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
EDITOR_INITIAL_EMAIL=
EDITOR_INITIAL_PASSWORD=

# 5. Folder Penyimpanan Upload Gambar Persisten (Contoh: /home/username_cpanel/fsdanrekan_uploads)
UPLOAD_DIR=

# 6. Email Transaksional SMTP cPanel (Contoh: mail.fsdanrekan.com, Port 465 SSL)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
INQUIRY_TO=

# 7. Perlindungan Anti-Spam Cloudflare Turnstile & Cron Retensi Data
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=

# 8. Opsional / Fallback (Upstash Redis, Resend, Sentry, Payload Legacy)
DATABASE_URI=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=

# 9. Fitur v2 (WhatsApp Cloud API & Instagram Graph API / SK-13)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PROFILE_URL=
